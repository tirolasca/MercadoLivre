MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=mercadolivre
MONGODB_COLLECTION=produtos

REDIS_HOST=seu-host.db.redis.io
REDIS_PORT=11415
REDIS_PASSWORD=sua_senha
# use true apenas se o seu banco no Redis Cloud tiver TLS habilitado
REDIS_SSL=false
# alternativa: URL completa (tem prioridade sobre as variáveis acima)
# REDIS_URL=redis://:senha@host:porta/0

# tempo de vida da sessão, em segundos
SESSION_EXPIRATION=60

# Cassandra (DataStax Astra DB, Serverless non-vector)
# caminho do secure-connect-mercadolivre.zip baixado no painel do Astra
ASTRA_SCB_PATH=C:/caminho/secure-connect-mercadolivre.zip
# token da aplicacao (comeca com AstraCS:)
ASTRA_DB_TOKEN=AstraCS:seu_token
# keyspace criado no painel do Astra (padrão: mercadolivre)
# ASTRA_KEYSPACE=mercadolivre

# Neo4j (AuraDB)
# o painel do Aura oferece o download de um arquivo .txt com estas variaveis
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sua_senha
# NEO4J_DATABASE=neo4j

# ----------------------------------------------------------------------------
# Interface web (Streamlit)
# ----------------------------------------------------------------------------
# production (padrão) | development. Em development, a web cria contas descartáveis
# (admin / admin-dev-local) SOMENTE se você não definir AUTH_USUARIOS. Nunca use em produção.
APP_ENV=production
# true: visitantes navegam em modo somente leitura, com dados pessoais mascarados
DEMO_MODE=true
# Contas da web em JSON; gere o hash com: python -m web.auth.senhas
# AUTH_USUARIOS=[{"usuario":"admin","papel":"admin","email":"admin@exemplo.com","senha_hash":"pbkdf2_sha256$600000$SAL$HASH"}]
# duração da sessão de login web, em segundos (renovada a cada ação)
WEB_SESSION_TTL=1800

# Cassandra em hospedagem sem upload de arquivo: bundle em base64 (alternativa ao ASTRA_SCB_PATH)
# ASTRA_SCB_B64=

# Limites de conexões por banco (planos gratuitos limitam: Redis Cloud Free = 30)
# MONGODB_MAX_POOL=10
# REDIS_MAX_CONNECTIONS=10
# NEO4J_MAX_POOL=10
