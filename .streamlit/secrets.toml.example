# Modelo dos Secrets do Streamlit. COPIE para .streamlit/secrets.toml (local, ignorado pelo Git)
# ou cole o conteúdo em App settings > Secrets no Streamlit Community Cloud.
# Todos os valores abaixo são FICTÍCIOS.

APP_ENV = "production"      # production (padrão, mais restritivo) | development
DEMO_MODE = "true"          # true: visitantes veem os dados (mascarados) sem login; false: tudo exige login

# MongoDB Atlas
MONGODB_URI = "mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
MONGODB_DATABASE = "mercadolivre"

# Redis Cloud
REDIS_HOST = "redis-12345.c1.us-east-1-2.ec2.cloud.redislabs.com"
REDIS_PORT = "12345"
REDIS_PASSWORD = "SENHA"
REDIS_SSL = "false"

# Astra DB (Cassandra): o Streamlit Cloud não aceita upload de arquivo,
# então o Secure Connect Bundle vai em base64 (veja docs/DEPLOY.md).
ASTRA_SCB_B64 = "UEsDBBQAAAAIA...base64-do-secure-connect-bundle..."
ASTRA_DB_TOKEN = "AstraCS:xxxxxxxx:yyyyyyyy"
ASTRA_KEYSPACE = "mercadolivre"

# Neo4j AuraDB
NEO4J_URI = "neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "SENHA"

# Contas da aplicação web. Gere cada senha_hash com:  python -m web.auth.senhas
# papel: "admin" (gerencia tudo) ou "usuario" (consulta e compra em seu próprio nome).
# O e-mail da conta deve ser o mesmo do cadastro do comprador no MongoDB.
[[auth.usuarios]]
usuario = "admin"
papel = "admin"
email = "admin@exemplo.com"
senha_hash = "pbkdf2_sha256$600000$SAL_BASE64$HASH_BASE64"

[[auth.usuarios]]
usuario = "maria"
papel = "usuario"
email = "maria@exemplo.com"
senha_hash = "pbkdf2_sha256$600000$SAL_BASE64$HASH_BASE64"
